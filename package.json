{
  "name": "gov-uk-driving-docs-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic RAG assistant that answers UK driving questions from GOV.UK pages, cites its sources, and is scored against a hand-checked golden set.",
  "scripts": {
    "slice:check": "tsx scripts/slice-check.ts",
    "precheck": "tsx scripts/precheck.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "tsx scripts/ingest.ts",
    "search": "tsx scripts/search.ts",
    "slice:discover": "tsx scripts/slice-discover.ts",
    "golden:check": "tsx scripts/golden-check.ts",
    "golden:pages": "tsx scripts/golden-pages.ts",
    "eval": "tsx scripts/eval.ts",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "web:build": "next build --webpack",
    "web:start": "next start",
    "evals:data": "tsx scripts/build-evals-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "cheerio": "^1.0.0",
    "dotenv": "^18.0.10",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
